{
  "name": "agent-switchboard-desktop",
  "version": "0.3.0",
  "description": "Agent Switchboard desktop app (Electron)",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "sync": "node sync-src.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --publish never",
    "e2e": "npm run sync && node test/e2e.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "io.github.cumabozkurt.agentswitchboard",
    "productName": "Agent Switchboard",
    "icon": "assets/icon.png",
    "protocols": [
      {
        "name": "Agent Switchboard link",
        "schemes": [
          "aswitch"
        ]
      }
    ],
    "files": [
      "main.js",
      "app-src/**",
      "assets/**",
      "models/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Cuma Bozkurt <cumabozkurt@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-win-${arch}.${ext}"
    }
  },
  "author": {
    "name": "Cuma Bozkurt",
    "email": "cumabozkurt@users.noreply.github.com"
  },
  "homepage": "https://github.com/cumabozkurt/agent-switchboard"
}
