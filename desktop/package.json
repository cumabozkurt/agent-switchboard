{
  "name": "agent-switchboard-desktop",
  "version": "0.1.0",
  "description": "Agent Switchboard masaüstü uygulaması (Electron)",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "sync": "node sync-src.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.cumabozkurt.agentswitchboard",
    "productName": "Agent Switchboard",
    "files": ["main.js", "app-src/**"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
