{
  "name": "agent-switchboard",
  "version": "0.4.1",
  "description": "API/model switcher for Claude Code, Codex and OpenCode: switch providers, fetch live model lists, translate protocols with a local router, restore originals. CLI + desktop app, English and Turkish. macOS, Windows, Linux.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aswitch": "bin/aswitch.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "ui": "node bin/aswitch.js ui"
  },
  "files": [
    "bin",
    "src",
    "models",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "openrouter",
    "llm",
    "proxy",
    "router",
    "cli",
    "anthropic",
    "openai",
    "i18n"
  ],
  "author": "Cuma Bozkurt",
  "homepage": "https://github.com/cumabozkurt/agent-switchboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/cumabozkurt/agent-switchboard.git"
  }
}
